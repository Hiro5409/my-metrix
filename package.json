{
  "name": "my-metrix",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "cli": "bun --env-file=.setup.env scripts/cli.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "deploy": "wrangler deploy --minify",
    "dev": "wrangler dev --port 8788",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "knip": "knip",
    "test": "bun test",
    "typecheck": "bun run types && tsc --noEmit",
    "types": "wrangler types --include-env=false",
    "check": "bun run lint && bun run format:check && bun run typecheck && bun run test && bun run knip",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@better-auth/api-key": "1.7.5",
    "@better-auth/drizzle-adapter": "1.7.5",
    "@hono/valibot-validator": "^0.6.1",
    "better-auth": "1.7.5",
    "drizzle-orm": "1.0.0-rc.4",
    "hono": "^4.13.8",
    "valibot": "^1.5.0",
    "withings-cli": "^0.3.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.2",
    "drizzle-kit": "1.0.0-rc.4",
    "knip": "^6.37.0",
    "lefthook": "^2.1.14",
    "miniflare": "5.20260918.0-alpha",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "typescript": "^7.0.2",
    "wrangler": "^4.135.0"
  },
  "packageManager": "bun@1.4.2"
}
